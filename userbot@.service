# Пользовательский сервис systemd — по одному на аккаунт (main или имя из accounts/).
#   cp userbot@.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now userbot@main userbot@work
# Не запускай одновременно с userbot.service — он тот же аккаунт main.
[Unit]
Description=Telegram LLM userbot (%i)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=%h/Documents/deepseek-harness/default-workspace/userbot
ExecStart=%h/Documents/deepseek-harness/default-workspace/userbot/.venv/bin/python userbot.py --account %i
Environment=PYTHONUNBUFFERED=1
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
