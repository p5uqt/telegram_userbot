# ════════════════════════════════════════════════════════════════════════
#  Скопируй в .env и заполни:   cp .env.example .env
#  Строки с # — комментарии. Кавычки вокруг значений не обязательны.
# ════════════════════════════════════════════════════════════════════════

# ── 1. Telegram (обязательно) ───────────────────────────────────────────
# https://my.telegram.org → API development tools → создать приложение
TG_API_ID=
TG_API_HASH=

# ── 2. Кому отвечать ────────────────────────────────────────────────────
# Режим A — обычные личные чаты по белому списку:
#   @username или числовой id через запятую
ALLOW_USERS=
#   1 = отвечать ещё и всем, кого нет в твоих контактах
ALLOW_NON_CONTACTS=0

# Режим B — только анонимный чат-бот (например AnonRuBot), без @.
#   Если заполнено — бот отвечает ТОЛЬКО там, белый список не используется.
ANON_BOT=
#   после «Собеседник закончил» самому отправлять /search
AUTO_NEXT=1

# ── 3. Модель (движок) ──────────────────────────────────────────────────
# openai   — любой OpenAI-совместимый API: llama.cpp, LM Studio, vLLM,
#            Ollama (/v1), OpenRouter, DeepSeek, OpenAI и т.д.
# llamacpp — то же, что openai, + параметры llama-server (top_k, min_p,
#            переключение размышлений Qwen). Только для llama-server!
# ollama   — родной API Ollama (/api/chat)
# dsh      — DeepSeek Harness (CLI)
ENGINE=openai

# Для ENGINE=openai / llamacpp:
LLM_URL=http://127.0.0.1:8080/v1
LLM_MODEL=local
# ключ API: для облака обязателен, для локальных серверов — пусто
LLM_API_KEY=
LLM_TEMP=0.7
LLM_MAX_TOKENS=300
# 1 = размышления (умнее, но ответ в разы дольше). Для llamacpp/Qwen3
LLM_THINK=0
# 1 = бот показывает модели присланные фото (нужна vision-модель;
#     для llama.cpp — сервер с --mmproj)
LLM_VISION=0
LLM_TIMEOUT_SECONDS=240
# таймаут запросов к Telegram, сек: у Telethon своего таймаута нет, и на
# полумёртвом соединении бот может залипнуть навсегда до перезапуска
TG_TIMEOUT_SECONDS=60
# через сколько секунд ответ, который «висит», снимается и генерируется заново
WORKER_MAX_SECONDS=900

# Для ENGINE=ollama:
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_NUM_CTX=16384
OLLAMA_THINK=0
OLLAMA_TEMP=0.6

# Для ENGINE=dsh (DeepSeek Harness):
DEEPSEEK_API_KEY=
BRIDGE_DSH_BIN=dsh
BRIDGE_PROFILE=headless

# ── 4. Кто ты ───────────────────────────────────────────────────────────
# m | f — как бот отвечает на «м/д» в анонимных чатах
OWNER_GENDER=m
# Остальное о тебе — в файле persona.md (шаблон: persona.example.md)

# ── 5. «Человечность» и лимиты (обычный режим) ─────────────────────────
# пауза перед прочтением, секунды (случайно между MIN и MAX)
READ_DELAY_MIN=15
READ_DELAY_MAX=90
# ждать, пока собеседник перестанет слать сообщения подряд, секунды
QUIET_SECONDS=12
# сколько секунд висит «печатает» перед отправкой ПЕРВОГО сообщения ответа
# (пока модель генерирует, «печатает» уже висит — поэтому можно мало)
TYPING_FIRST_SECONDS=-1
# сколько секунд «печатает» перед каждым СЛЕДУЮЩИМ сообщением ответа
# -1 = авто по длине сообщения (0.3–1.5 сек)
TYPING_NEXT_SECONDS=-1
# если ты сам писал в чате последние N минут — бот молчит
TAKEOVER_MINUTES=30
MAX_REPLIES_PER_HOUR=20
# сколько последних сообщений чата отдавать модели
HISTORY_MESSAGES=40

# первое сообщение в каждом новом чате; пусто = ничего не отправлять
# (бот не признаётся, что отвечает ИИ)
DISCLOSURE_TEXT=
# 1 = дублировать ответы бота и ошибки тебе в «Избранное»
NOTIFY=1

# ── 6. Анонимный чат ────────────────────────────────────────────────────
ANON_MAX_REPLIES_PER_HOUR=60
ANON_HISTORY_MESSAGES=24
# сколько минут бот ждёт, если ты сам написал в анонимный чат
ANON_TAKEOVER_MINUTES=2
# если заполнено — отправляется каждому новому собеседнику первым сообщением
# (по умолчанию пусто: бот не признаётся, что отвечает ИИ)
ANON_DISCLOSURE_TEXT=

# Папка с файлами, которые бот может отправлять (и куда сохраняет созданные им)
FILES_DIR=

# Голосовые и кружочки: распознавание речи локально (faster-whisper, CPU; нужен ffmpeg).
# Модель: tiny | base | small | medium | large-v3 (больше — точнее и медленнее). Пусто/0 — выключить.
WHISPER_MODEL=small
WHISPER_THREADS=4
# Язык: ru / uk / en; пусто — определять автоматически
WHISPER_LANGUAGE=
# Голосовые длиннее стольких секунд бот «не слушает»
VOICE_MAX_SECONDS=300

# Видео и кружочки: бот смотрит несколько кадров (одной картинкой-сеткой) + слушает звук.
# Нужен LLM_VISION=1. Кадров: 4 (2×2), 6 (3×2) или 9 (3×3)
VIDEO_FRAMES=4
# видео тяжелее стольких МБ целиком не качаются — только превью
VIDEO_MAX_MB=300

# ── 7. Отправка своих фото / видео / голосовых / кружочков ────────────
# Какие виды бот может отправлять: photo,video,voice,round (или all). Пусто — выключено.
MEDIA_SEND=
# Папка: media/photo, media/video, media/voice, media/round.
# Файлы в подпапке later/ (например media/photo/later/) — «потянуть время»:
# на первую просьбу бот отмазывается, а отправляет с задержкой.
# Описания и настройки по файлам — media/media.toml (шаблон: media.example.toml)
MEDIA_DIR=
# задержка для «потянуть время», минуты (случайно между MIN и MAX)
# 0 = отправлять ТОЛЬКО когда собеседник сам просит («скинь фотку», «запиши гс»,
#     «покажи кота»), и только тот вид, который просят (по умолчанию)
# 1 = бот может сам отправить, когда это к месту по разговору
MEDIA_SELF=0
MEDIA_LATER_MIN=10
MEDIA_LATER_MAX=60

# ── Опечатки «как с телефона» ───────────────────────────────────────────
# доля ответов с опечаткой (0.06 = ~6%); 0 — без опечаток
TYPO_CHANCE=0.06
# доля опечаток, которые бот сразу исправляет отдельным сообщением «*слово»
# (0.35 = ~каждую третью; 1 — всегда; 0 — никогда)
TYPO_FIX_CHANCE=0.35

# ── Входящие звонки ─────────────────────────────────────────────────────
# ignore       — не трогать: звонок идёт как обычно, бот ничего не делает
# decline      — сбросить
# decline_text — сбросить и написать, что сейчас не может говорить (своими словами)
# Касается только тех, кому бот отвечает (белый список); если ты сам возьмёшь трубку
# до сброса — бот ничего не делает. На паузе (.ub pause / pause) звонки не трогает.
CALLS=ignore
# через сколько секунд после начала звонка сбрасывать (случайно между MIN и MAX)
CALL_DECLINE_MIN=4
CALL_DECLINE_MAX=12
